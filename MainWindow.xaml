<Window x:Class="PrReviewHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PrReviewHelper.ViewModels"
        Title="PR Review Helper" Height="800" Width="1400"
        Background="{StaticResource Brush.Bg}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Brush.BgElev}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AI Tool:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Brush.TextMuted}" FontWeight="SemiBold"/>
                    <ComboBox Width="150" SelectedItem="{Binding SelectedAiTool, Mode=TwoWay}" ItemsSource="{Binding AiTools}" Padding="4"/>
                </StackPanel>
                <TextBlock Text="PR REVIEW HELPER" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Brush.Accent}"/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="6">
        <!-- ============================== CREATE BRANCH TAB ============================== -->
        <TabItem Header="Create branch" DataContext="{Binding CreateBranch}">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBar}">
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Brush.TextMuted}"/>
                </Border>

                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="200"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Repo" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBox  Grid.Row="0" Grid.Column="1"
                              Text="{Binding RepoPath, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,6"/>
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,6">
                        <Button Content="Browse…" Command="{Binding BrowseRepoCommand}"/>
                        <Button Content="Backend" Command="{Binding UseBackendRepoCommand}" Margin="6,0,0,0"/>
                        <Button Content="Frontend" Command="{Binding UseFrontendRepoCommand}" Margin="2,0,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Jira ticket" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBox  Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                              Text="{Binding Ticket, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,6"
                              ToolTip="Accepts 'CLOUD-331' or just '331' (uses Jira project key by default)."/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Preview" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                               Text="{Binding PreviewBranchName}"
                               FontFamily="Consolas" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,6"/>

                    <!-- Sprint board picker header: assignee filter + refresh -->
                    <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Active sprint tickets" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Assignee:" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{StaticResource Brush.TextMuted}"/>
                        <ComboBox Grid.Column="2" Width="200" Padding="4"
                                  ItemsSource="{Binding AssigneeOptions}"
                                  SelectedItem="{Binding AssigneeFilter, Mode=TwoWay}"/>
                        <Button   Grid.Column="3" Content="Refresh" Command="{Binding RefreshIssuesCommand}" Margin="6,0,0,0"/>
                    </Grid>

                    <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                            Background="{StaticResource Brush.BgElev}" CornerRadius="4">
                        <ListView ItemsSource="{Binding IssuesView}"
                                  SelectedItem="{Binding SelectedIssue}"
                                  Background="Transparent" BorderThickness="0"
                                  HorizontalContentAlignment="Stretch"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Type badge -->
                                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="3"
                                                Background="{Binding TypeColor}" HorizontalAlignment="Left"
                                                ToolTip="{Binding IssueTypeName}">
                                            <TextBlock Text="{Binding TypeBadge}" Foreground="White"
                                                       FontWeight="Bold" FontSize="11"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Key -->
                                        <TextBlock Grid.Column="1" Text="{Binding Key}"
                                                   FontFamily="Consolas" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Accent}"
                                                   VerticalAlignment="Center" Margin="8,0,8,0"/>

                                        <!-- Summary -->
                                        <TextBlock Grid.Column="2" Text="{Binding Summary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>

                                        <!-- Status pill -->
                                        <Border Grid.Column="3" CornerRadius="10" Padding="8,2"
                                                Background="{Binding StatusColor}" Margin="12,0,12,0">
                                            <TextBlock Text="{Binding StatusName}" Foreground="White"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- Assignee avatar -->
                                        <Border Grid.Column="4" Width="22" Height="22" CornerRadius="11"
                                                Background="{StaticResource Brush.BgHover}"
                                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                                ToolTip="{Binding AssigneeName}">
                                            <TextBlock Text="{Binding AssigneeInitials}" FontSize="10"
                                                       Foreground="{StaticResource Brush.Text}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                                Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Stash" Command="{Binding StashCommand}"
                                ToolTip="git stash push --include-untracked"/>
                        <Button Content="Pop stash" Command="{Binding StashPopCommand}" Margin="6,0,0,0"
                                ToolTip="git stash pop"/>
                        <Button Content="Create branch" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- ============================== CREATE PR TAB ============================== -->
        <TabItem Header="Create PR" DataContext="{Binding PrCreate}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="8,8,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Repo" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBox  Grid.Row="0" Grid.Column="1"
                              Text="{Binding RepoPath, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,6"/>
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,6">
                        <Button Content="Browse…" Command="{Binding BrowseRepoCommand}"/>
                        <Button Content="Backend" Command="{Binding UseBackendRepoCommand}" Margin="6,0,0,0"/>
                        <Button Content="Frontend" Command="{Binding UseFrontendRepoCommand}" Margin="2,0,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="PR template" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBox  Grid.Row="1" Grid.Column="1"
                              Text="{Binding TemplatePath, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,6"/>
                    <Button   Grid.Row="1" Grid.Column="2" Content="Browse…"
                              Command="{Binding BrowseTemplateCommand}" Margin="6,0,0,6"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Base branch" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBox  Grid.Row="2" Grid.Column="1"
                              Text="{Binding BaseBranch, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,6"/>
                </Grid>

                <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBar}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}"/>
                        <Button Grid.Column="1" Content="Open PR" Command="{Binding OpenPrCommand}" Padding="8,2" MinWidth="0"/>
                    </Grid>
                </Border>

                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="80"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*" MinHeight="200"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Brief / extra context for AI (optional)" Margin="0,0,0,2"/>
                    <TextBox Grid.Row="1" Text="{Binding Brief, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Padding="6"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,8">
                        <Button Content="Generate" Command="{Binding GenerateCommand}" Style="{StaticResource SuccessButton}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="Title (editable)" FontWeight="SemiBold" Margin="0,4,0,2"/>
                    <TextBox  Grid.Row="4" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>

                    <GroupBox Grid.Row="5" Header="Description (editable)" Margin="0,6,0,0">
                        <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" Padding="6"/>
                    </GroupBox>

                    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Create PR" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- ============================== CODE REVIEW TAB ============================== -->
        <TabItem Header="Code review" DataContext="{Binding Pr}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="8,8,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Repo:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1" Text="{Binding RepoPath, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="4"/>
                    <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseCommand}" Margin="6,0,0,0"/>
                    <Button Grid.Column="3" Content="Backend" Command="{Binding LoadBackendCommand}" Margin="6,0,0,0"/>
                    <Button Grid.Column="4" Content="Frontend" Command="{Binding LoadFrontendCommand}" Margin="2,0,0,0"/>
                    <Button Grid.Column="5" Content="Load PR" Command="{Binding LoadCommand}" Margin="6,0,0,0"/>
                    <TextBlock Grid.Column="6" Text="{Binding PrTitle}" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold"/>
                </Grid>

                <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBar}">
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Brush.TextMuted}"/>
                </Border>

                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" MinWidth="200"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="400"/>
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0" ItemsSource="{Binding Comments}" SelectedItem="{Binding Selected}"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CommentViewModel}">
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding StateLabel}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Header}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <GridSplitter Grid.Column="1" Style="{StaticResource VSplitter}"/>

                    <Grid Grid.Column="2" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="80"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="60"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*" MinHeight="80"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding Selected.FileLine}" FontWeight="SemiBold" Margin="0,0,0,6"/>

                        <GroupBox Grid.Row="1" Header="Code">
                            <TextBox Text="{Binding Selected.CodeContext, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="12"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     BorderThickness="0" Padding="6"/>
                        </GroupBox>

                        <GridSplitter Grid.Row="2" Style="{StaticResource HSplitter}"/>

                        <GroupBox Grid.Row="3" Header="Thread">
                            <TextBox Text="{Binding Selected.ThreadText, Mode=OneWay}" IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="6"/>
                        </GroupBox>

                        <GridSplitter Grid.Row="4" Style="{StaticResource HSplitter}"/>

                        <GroupBox Grid.Row="5" Header="Suggested reply (editable)">
                            <TextBox Text="{Binding Selected.Reply, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Padding="6"/>
                        </GroupBox>

                        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="Regenerate" Command="{Binding RegenerateCommand}"/>
                            <Button Content="Implement" Command="{Binding ImplementCommand}"/>
                            <Button Content="Stage (copy)" Command="{Binding StageCommand}"/>
                            <Button Content="Post" Command="{Binding PostCommand}" Style="{StaticResource PrimaryButton}"/>
                            <Button Content="Deny" Command="{Binding DenyCommand}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- ============================== JIRA TAB ============================== -->
        <TabItem Header="Jira Ticket" DataContext="{Binding Jira}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="8,8,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Project: "/>
                        <Run Text="{Binding ProjectKey, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="    Team: "/>
                        <Run Text="{Binding TeamName, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <Button Grid.Column="1" Content="Settings…" Command="{Binding SettingsCommand}"/>
                </Grid>

                <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBar}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}"/>
                        <Button Grid.Column="1" Content="Open ticket" Command="{Binding OpenTicketCommand}" Padding="8,2" MinWidth="0"/>
                    </Grid>
                </Border>

                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="120"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*" MinHeight="200"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Title" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBox  Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                              Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Issue type" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                              ItemsSource="{Binding IssueTypes}" SelectedItem="{Binding SelectedIssueType}"
                              Margin="0,0,0,6" Padding="4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="DoR template" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBox  Grid.Row="2" Grid.Column="1"
                              Text="{Binding DorTemplatePath, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,6"/>
                    <Button   Grid.Row="2" Grid.Column="2" Content="Browse…"
                              Command="{Binding BrowseDorCommand}" Margin="6,0,0,6"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                               Text="Brief / context for AI (the more, the better)" Margin="0,6,0,2"/>
                    <TextBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                             Text="{Binding Brief, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Padding="6"/>

                    <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,4">
                        <Button Content="Generate" Command="{Binding GenerateCommand}" Style="{StaticResource SuccessButton}"/>
                    </StackPanel>

                    <GroupBox Grid.Row="6" Grid.ColumnSpan="3" Header="Generated description (editable)">
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" Padding="6"/>
                    </GroupBox>

                    <StackPanel Grid.Row="7" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Create ticket" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </TabItem>
    </TabControl>
    </Grid>
</Window>
